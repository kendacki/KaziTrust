# Wording. Sentences only. Does not change a score.
GROQ_API_KEY=
# Sign-in. Required before a key can be created on a production build.
# The Privy app must allow https://kazitrustai.fun and https://www.kazitrustai.fun. A missing origin makes signup say something went wrong.
PRIVY_APP_ID=
VITE_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Labels, portfolio, and recent DeFi activity.
SOLSCAN_API_KEY=
# Token risk for a mint. Separate from the KaziTrust score.
RUGCHECK_API_KEY=
# First Solana node. Public nodes are the fallback.
FLUX_RPC_URL=
# Optional analytics durability (Upstash Redis / Vercel KV). Without these, events still log and keep a local ring/file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Bearer token required for GET /api/analytics summaries.
ANALYTICS_TOKEN=
# Optional fixed API key hash (sha256 hex of kt_...) for production gateway checks.
KAZITRUST_API_KEY_HASH=
# Daily MCP/API reads per issued key (wallet_snapshot, token_risk, /api/v1 services). Default 30.
KAZITRUST_API_DAILY_READS=30
