{
  "functions": {
    "api/mcp.js": {
      "includeFiles": "mcp/**"
    },
    "api/analytics.js": {
      "includeFiles": "mcp/**"
    },
    "api/v1/[[...path]].js": {
      "includeFiles": "mcp/**"
    },
    "api/solscan.js": {
      "includeFiles": "mcp/**"
    },
    "api/rugcheck.js": {
      "includeFiles": "mcp/**"
    },
    "api/restrictions.js": {
      "includeFiles": "mcp/**"
    },
    "api/groq.js": {
      "includeFiles": "mcp/**"
    },
    "api/keys.js": {
      "includeFiles": "mcp/**"
    },
    "api/rpc.js": {
      "includeFiles": "mcp/**"
    }
  },
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/favicon.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/avatar.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ],
  "rewrites": [
    { "source": "/rpc", "destination": "/api/rpc" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
